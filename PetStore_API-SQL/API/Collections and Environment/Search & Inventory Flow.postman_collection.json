		{
			"name": "Get findByStatus =available",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response is not empty\", function () {\r",
							"    const json = pm.response.json();\r",
							"    pm.expect(json.length).to.be.above(0);\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							"\r",
							"/*I validate response structure by checking required fields in array items.*/\r",
							"pm.test(\"Each pet contains required fields\", function () {\r",
							"    const json = pm.response.json();\r",
							"\r",
							"    pm.expect(json[0]).to.have.property(\"id\");\r",
							"    pm.expect(json[0]).to.have.property(\"name\");\r",
							"    pm.expect(json[0]).to.have.property(\"status\");\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Status matches requested filter\", function () {\r",
							"    const json = pm.response.json();\r",
							"    const requestedStatus = pm.request.url.query.get(\"status\");\r",
							"\r",
							"    json.forEach(pet => {\r",
							"        pm.expect(pet.status).to.equal(requestedStatus);\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_URL}}/pet/findByStatus?status=available",
					"host": [
						"{{base_URL}}"
					],
					"path": [
						"pet",
						"findByStatus"
					],
					"query": [
						{
