	"item": [
		{
			"name": "Create new pet",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"//generate unique ID\r",
							"const petId = Math.floor(Math.random() * 1000000);\r",
							"\r",
							"//generate name of pet\r",
							"const petName = pm.variables.replaceIn(\"{{$randomFirstName}}\");\r",
							"\r",
							"pm.collectionVariables.set(\"petId\", petId);\r",
							"pm.collectionVariables.set(\"petName\", petName);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"/*I validate that the status field contains only allowed business values to prevent invalid product states.*/\r",
							"pm.test(\"Status has valid value\", function () {\r",
							"    const json = pm.response.json();\r",
							"    const validStatuses = [\"available\", \"sold\", \"pending\"];\r",
							"\r",
							"    pm.expect(validStatuses).to.include(json.status);\r",
							"});\r",
							"\r",
							"/*The root-level name represents the pet's name, which is a mandatory business field.\r",
							"Category and tag names are metadata and are not validated in this scenario.*/\r",
							"pm.test(\"Name is not empty\", function () {\r",
							"    const json = pm.response.json();\r",
							"\r",
							"    pm.expect(json).to.have.property(\"name\");\r",
							"    pm.expect(json.name).to.be.a(\"string\");\r",
							"    pm.expect(json.name.length).to.be.above(0);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
