			"name": "Create new pet status available",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"//generate unique ID\r",
							"const petId_3 = Math.floor(Math.random() * 1000000);\r",
							"\r",
							"//generate name of pet\r",
							"const petName = pm.variables.replaceIn(\"{{$randomFirstName}}\");\r",
							"\r",
							"pm.environment.set(\"petId_3\", petId_3);\r",
							"pm.collectionVariables.set(\"petName\", petName);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
