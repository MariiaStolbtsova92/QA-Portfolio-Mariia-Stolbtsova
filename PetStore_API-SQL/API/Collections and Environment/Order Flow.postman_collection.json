		{
			"name": "Check order in base",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Quantity is greater than zero\", function () {\r",
							"    const json = pm.response.json();\r",
							"\r",
							"    pm.expect(json).to.have.property(\"quantity\");\r",
							"    pm.expect(json.quantity).to.be.a(\"number\");\r",
							"    pm.expect(json.quantity).to.be.above(0);\r",
							"});\r",
							"/*I validated that order quantity follows business rules and cannot be /zero or negative.*/"
						],
